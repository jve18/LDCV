\end{equation}

\begin{equation}
  \frac{\partial{u_{2,(m,n)}^{*}}}{\partial{x_{2,n}}} \approx \frac{u_{2,(m,n+1)} - u_{1,(m,n)}}{\Delta{x_{2}}}
