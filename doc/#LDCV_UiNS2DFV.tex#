\end{equation}

\begin{equation}
  \frac{\partial{u_{1,(m,n)}^{*}}}{\partial{x_{1,m}}} \approx \frac{u_{1,(m+1,n)} - u_{1,(m,n)}}{\Delta{x_{1}}}
